#version 460

// Source HDR bloom, stage 2: separable Gaussian blur at quarter resolution.
//
// Source runs a horizontal then a vertical pass over the downsampled bright
// buffer (the blurx/blury materials). The direction comes from a push constant
// so both passes share one pipeline, and the images ping-pong between them.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 15, rgba16f) uniform image2D bloomA;
layout(set = 0, binding = 16, rgba16f) uniform image2D bloomB;

layout(push_constant) uniform BlurPush {
    // 0 = horizontal, reads A writes B. 1 = vertical, reads B writes A.
    uint vertical;
} push;

// Nine-tap Gaussian, sigma ~2 texels at quarter resolution.
const float kWeights[5] = float[5](0.2270270270, 0.1945945946, 0.1216216216,
                                   0.0540540541, 0.0162162162);

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(bloomA);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    bool vertical = push.vertical != 0u;
    ivec2 step = vertical ? ivec2(0, 1) : ivec2(1, 0);

    vec3 accumulated = (vertical ? imageLoad(bloomB, pixel) : imageLoad(bloomA, pixel)).rgb *
                       kWeights[0];
    for (int tap = 1; tap < 5; ++tap) {
        ivec2 forward = clamp(pixel + step * tap, ivec2(0), size - 1);
        ivec2 backward = clamp(pixel - step * tap, ivec2(0), size - 1);
        vec3 a = (vertical ? imageLoad(bloomB, forward) : imageLoad(bloomA, forward)).rgb;
        vec3 b = (vertical ? imageLoad(bloomB, backward) : imageLoad(bloomA, backward)).rgb;
        accumulated += (a + b) * kWeights[tap];
    }

    if (vertical) imageStore(bloomA, pixel, vec4(accumulated, 1.0));
    else          imageStore(bloomB, pixel, vec4(accumulated, 1.0));
}
