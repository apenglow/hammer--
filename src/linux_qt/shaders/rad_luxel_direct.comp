#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

// VRAD pass: direct lighting per luxel.
//
// Mirrors GatherSampleLight over every map light for each sample produced by
// BuildFacesamples(), and writes the result into the HDR lightmap atlas. Alpha
// records coverage so the resolve pass can dilate into texels no sample reached.

layout(local_size_x = 64) in;

#include "rad_common.glsl"

// emit_skyambient hemisphere samples. VRAD uses NUMVERTEXNORMALS (162); a bake
// that has to stay interactive gets a stratified subset instead.
const int SKY_AMBIENT_SAMPLES = 16;

// VRAD's extra sampling pass (do_extra, on by default in a real compile) splits
// every luxel into a grid of sample points and averages them. That is what makes
// a shadow edge fade: a luxel the boundary crosses records partial coverage
// instead of a single hit-or-miss test. Without it the lightmap is binary per
// luxel and no amount of filtering can recover the gradient, which is why the
// preview's shadows terminated in a hard stair-stepped edge while the game's
// fade out. 2x2 matches VRAD's extra pass at four shadow rays per light.
const int LUXEL_SUPERSAMPLES = 2;


void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= radControl.counts.x) return;

    LuxelRecord luxel = luxels[index];
    vec3 position = luxel.position.xyz;
    vec3 normal = normalize(luxel.normal.xyz);

    vec3 direct = vec3(0.0);
    vec3 ambient = vec3(0.0);

    RectRecord rect = luxelRects[uint(luxel.atlas.w)];
    float luxelScale = max(rect.origin.z, 1e-4);
    vec3 uStep = normalize(rect.uAxis.xyz) * luxelScale;
    vec3 vStep = normalize(rect.vAxis.xyz) * luxelScale;

    for (uint i = 0u; i < mapLights.length(); ++i) {
        LightRecord light = mapLights[i];
        if (light.positionType.w == RAD_EMIT_SKYAMBIENT) {
            // The _ambient term of light_environment. Its visibility is the
            // fraction of the hemisphere that reaches a sky surface, so it
            // correctly darkens indoors without an artificial ambient floor.
            vec3 accumulated = vec3(0.0);
            for (int s = 0; s < SKY_AMBIENT_SAMPLES; ++s) {
                vec3 direction = radStratifiedHemisphere(normal, uint(s),
                                                         uint(SKY_AMBIENT_SAMPLES));
                vec3 visible = radTransmission(position + normal * radControl.tuning.y,
                                                direction, 131072.0, true);
                accumulated += visible;
            }
            ambient += light.colorIntensity.rgb * light.colorIntensity.w *
                       (accumulated / float(SKY_AMBIENT_SAMPLES)) * radControl.tuning.z;
            continue;
        }
        // Average visibility across the luxel's own footprint. The footprint
        // axes come from the rect this luxel was packed into: rectTexel divides
        // by origin.z, so stepping one luxel along S is uAxis * lightmapScale.
        vec3 accumulated = vec3(0.0);
        for (int sy = 0; sy < LUXEL_SUPERSAMPLES; ++sy) {
            for (int sx = 0; sx < LUXEL_SUPERSAMPLES; ++sx) {
                vec2 offset = (vec2(sx, sy) + 0.5) / float(LUXEL_SUPERSAMPLES) - 0.5;
                vec3 shadowPosition = position + uStep * offset.x + vStep * offset.y;
                accumulated += gatherSampleLightFrom(
                    light, position, normal, shadowPosition,
                    uint(sy * LUXEL_SUPERSAMPLES + sx));
            }
        }
        direct += accumulated / float(LUXEL_SUPERSAMPLES * LUXEL_SUPERSAMPLES);
    }

    ivec2 texel = ivec2(luxel.atlas.xy);
    imageStore(lightmapImage, texel, vec4(direct + ambient, 1.0));
}
