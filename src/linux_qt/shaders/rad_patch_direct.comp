#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

// VRAD pass: per-patch direct lighting and reflectivity.
//
// CPatch carries `directlight` and `reflectivity`; this fills both. Reflectivity
// is the patch material's average base colour, which is what bounces energy in
// the radiosity solve and produces Source's characteristic colour bleed.

layout(local_size_x = 64) in;

#include "rad_common.glsl"

// Taps used to approximate the material's average albedo. VRAD reads the whole
// texture's average from the BSP's texdata reflectivity; sampling a small grid
// of the atlas rect is the equivalent that needs no extra upload.
const int REFLECTIVITY_TAPS = 4;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= radControl.counts.y) return;

    LuxelRecord patchSample = patches[index];
    vec3 position = patchSample.position.xyz;
    vec3 normal = normalize(patchSample.normal.xyz);

    vec3 direct = vec3(0.0);
    uint state = radHash(uvec3(index, 0x27d4eb2fu, 0x165667b1u));
    for (uint i = 0u; i < mapLights.length(); ++i) {
        LightRecord light = mapLights[i];
        if (light.positionType.w == RAD_EMIT_SKYAMBIENT) {
            vec3 direction = radCosineHemisphere(normal, state);
            vec3 visible = radTransmission(position + normal * radControl.tuning.y,
                                            direction, 131072.0, true);
            direct += light.colorIntensity.rgb * light.colorIntensity.w * visible *
                      radControl.tuning.z;
            continue;
        }
        direct += gatherSampleLight(light, position, normal);
    }

    uint rectIndex = uint(patchSample.atlas.w);
    MaterialRecord material = materials[patchRects[rectIndex].identity.x];
    vec3 albedo = vec3(0.0);
    for (int y = 0; y < REFLECTIVITY_TAPS; ++y) {
        for (int x = 0; x < REFLECTIVITY_TAPS; ++x) {
            vec2 uv = (vec2(x, y) + 0.5) / float(REFLECTIVITY_TAPS);
            albedo += sampleRect(material.baseRect, uv, vec4(0.5)).rgb;
        }
    }
    albedo /= float(REFLECTIVITY_TAPS * REFLECTIVITY_TAPS);
    // Atlas colour is UNORM sRGB; radiosity is linear.
    albedo = sourceGammaToLinear(albedo);

    vec3 reflectivity = clamp(albedo, vec3(0.0), vec3(1.0));
    patchDirect[index] = vec4(direct, 0.0);
    patchReflectivity[index] = vec4(reflectivity, 0.0);
    // The radiosity iteration gathers each patch's *exitance*, not the light
    // falling on it: in Bi = Ei + Pi * SUMj(Bj * Fij), Bj already has patch j's
    // own reflectivity folded in. Seeding this with bare irradiance made the
    // first bounce behave as if every surface were a perfect white reflector,
    // which both overstated it and stripped out the emitting surface's colour -
    // so no colour bleed, the one thing radiosity is supposed to produce.
    patchBounceA[index] = vec4(reflectivity * direct, 0.0);
    patchTotal[index] = vec4(0.0);
}
